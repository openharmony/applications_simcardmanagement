{
  "module": {
    "name": "entry",
    "type": "entry",
    "srcEntry": "./ets/Application/MyAbilityStage.ets",
    "description": "$string:simcardmanagement_desc",
    "mainElement": "com.ohos.simcardmanagement.MainAbility",
    "deviceTypes": [
      "default",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [
      {
        "name": "ArkTSPartialUpdate",
        "value": "true"
      },
      {
        "name": "action.settings.search.path",
        "value": "searchConfig/searchPage.json"
      },
      {
        "name": "intelligence_network_statement",
        "value": "rawfile:intelligence_network_statement.json"
      },
      {
        "name": "smart_dual_card_statement",
        "value": "rawfile:smart_dual_card_statement.json"
      }
    ],
    "abilities": [
      {
        "exported": false,
        "name": "DefaultIntentBackgroundUiAbility",
        "icon": "$media:app_icon",
        "description": "$string:MainAbility_desc",
        "label": "$string:MainAbility_label",
        "srcEntry": "./ets/insightintents/ability/DefaultIntentBackgroundUiAbility.ets",
        "launchType": "singleton",
        "orientation": "auto_rotation_restricted",
        "startWindowIcon": "$media:app_start_window_icon",
        "startWindowBackground": "$color:color_00000000_transparent",
        "removeMissionAfterTerminate": true
      }
    ],
    "extensionAbilities": [
      {
        "name": "com.ohos.simcardmanagement.MainAbility",
        "srcEntrance": "./ets/MainAbility/MainAbility.ets",
        "description": "$string:MainAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:MainAbility_label",
        "visible": true,
        "type": "sys/commonUI",
        "permissions": [
          'ohos.permission.SET_TELEPHONY_STATE'
        ]
      },
      {
        "name": "SmartDualCardDialogAbility",
        "srcEntry": "./ets/MainAbility/SmartDualCardDialogAbility.ets",
        "icon": "$media:app_icon",
        "description": "$string:MainAbility_desc",
        "label": "$string:MainAbility_label",
        "exported": true,
        "type": "sys/commonUI",
        "permissions": [
          'ohos.permission.SET_TELEPHONY_STATE'
        ]
      },
      {
        "name": "BackupExtensionAbility",
        "srcEntrance": "./ets/backup/BackupExtension.ets",
        "description": "$string:simcardmanagement_desc",
        "label": "$string:simcardmanagement_desc",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      },
      {
        "name":"MobileDataChangeExtAbility",
        "description":"MobileDataToggle",
        "srcEntry":"./ets/uiExtensionAbility/MobileDataChangeExtAbility.ets",
        "type":'sys/commonUI',
        "exported":true,
        "permissions":[
          "ohos.permission.SET_TELEPHONY_STATE"
        ]
      },
      {
        "name": "ReporterWorkSchedulerAbility",
        "srcEntry": "./ets/WorkSchedulerExtension/WorkSchedulerExtension.ets",
        "description": "$string:simcardmanagement_desc",
        "label": "$string:simcardmanagement_desc",
        "type": "workScheduler"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.SET_TELEPHONY_STATE",
        "reason": "$string:SET_TELEPHONY_STATE"
      },
      {
        "name": "ohos.permission.GET_TELEPHONY_STATE",
        "reason": "$string:GET_TELEPHONY_STATE"
      },
      {
        "name": "ohos.permission.USE_USER_IDM",
        "reason":"$string:USE_USER_IDM"
      },
      {
        "name": "ohos.permission.ACCESS_BIOMETRIC",
        "reason": "$string:ACCESS_BIOMETRIC"
      },
      {
        "name": "ohos.permission.PRIVACY_WINDOW",
        "reason": "$string:ACCESS_BIOMETRIC"
      },
      {
        "name": "ohos.permission.ACCESS_SYSTEM_SETTINGS",
        "reason": "$string:ACCESS_SYSTEM_SETTINGS"
      },
      {
        "name": "ohos.permission.MANAGE_SETTINGS",
      },
      {
        "name": "ohos.permission.MANAGE_SECURE_SETTINGS",
      },
      {
        "name": "ohos.permission.GET_BUNDLE_INFO",
      }
    ]
  }
}